# --- 核心排除 (防止 Git 崩潰與 6000+ 檔案的主因) ---
node_modules/
web/node_modules/
web/dist/
dist/

# --- 安全性排除 (保護你的 APS Client Secret) ---
.env
*.log

# --- 系統垃圾檔 ---
.DS_Store
Thumbs.db

# --- 影片與大型媒體 (避免 Push 失敗) ---
*.mp4
*.mov
*.avi
*.wmv
recordings/

# --- 圖片與截圖 ---
*.png
*.jpg
*.jpeg
*.svg
*.gif
repo/

# --- BIM 模型大檔案 (建議只留 URN 於代碼中，不要傳模型檔) ---
*.rvt
*.nwc
*.ifc
*.dwg

# --- 資料檔案 ---
# 如果你的 JSON/CSV 很大，建議排除，Demo 時再手動放入
web/src/public/data/*.json
web/src/public/data/*.csv
web/src/public/video/
web/src/public/data/peopleflow/


# --- Visual Studio Code 相關 ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
.git/objects/pack/
